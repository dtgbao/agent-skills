+# Feature: cart-discount-codes, Property 3: Discount formula matches the model
+@settings(max_examples=300)
+@given(
+    subtotal=st.integers(0, 100_000_000),
+    code=st.none() | percent_code | fixed_code,
+    today=st.dates(),
+)
+def test_discount_formula(subtotal, code, today):
+    if code is None or subtotal < code.minimum_cents or today > code.expires:
+        expected = 0
+    elif code.kind == "percent":
+        expected = subtotal * code.value // 100
+    else:
+        expected = min(code.value, subtotal)
+    got = discount_cents(subtotal, code, today)
+    assert got == expected
+    assert 0 <= got <= subtotal
+    assert subtotal - got >= 0
