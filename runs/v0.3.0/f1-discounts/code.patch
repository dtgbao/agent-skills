diff --git a/shop/discounts.py b/shop/discounts.py
new file mode 100644
index 0000000..1014b64
--- /dev/null
+++ b/shop/discounts.py
@@ -0,0 +1,86 @@
+"""Discount codes: record, registry, format checks, formula."""
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from datetime import date
+
+CODE_RE = re.compile(r"[A-Za-z0-9-]{1,20}")
+DATE_RE = re.compile(r"\d{4}-\d{2}-\d{2}")
+
+MAX_FIXED = 10_000_000
+MAX_MINIMUM = 10_000_000
+
+
+def _is_int(x: object) -> bool:
+    return type(x) is int
+
+
+@dataclass(frozen=True)
+class DiscountCode:
+    code: str
+    kind: str
+    value: int
+    minimum_cents: int
+    expires: date
+
+
+def is_well_formed(code: object) -> bool:
+    return isinstance(code, str) and CODE_RE.fullmatch(code) is not None
+
+
+def _parse_date(value: object) -> date:
+    if not isinstance(value, str) or DATE_RE.fullmatch(value) is None:
+        raise ValueError("bad date")
+    try:
+        return date.fromisoformat(value)
+    except ValueError:
+        raise ValueError("bad date") from None
+
+
+def parse_today(value: object) -> date:
+    return _parse_date(value)
+
+
+def discount_cents(subtotal: int, code: DiscountCode | None, today: date) -> int:
+    if code is None:
+        return 0
+    if subtotal < code.minimum_cents:
+        return 0
+    if today > code.expires:
+        return 0
+    if code.kind == "percent":
+        return subtotal * code.value // 100
+    return min(code.value, subtotal)
+
+
+class CodeRegistry:
+    def __init__(self) -> None:
+        self._codes: dict[str, DiscountCode] = {}
+
+    def register(self, code: str, kind: str, value: int,
+                 minimum_cents: int, expires: str) -> DiscountCode:
+        if not is_well_formed(code):
+            raise ValueError("bad code string")
+        if kind not in ("percent", "fixed"):
+            raise ValueError("bad kind")
+        if not _is_int(value):
+            raise ValueError("bad value")
+        if kind == "percent" and not 1 <= value <= 50:
+            raise ValueError("percent out of range")
+        if kind == "fixed" and not 1 <= value <= MAX_FIXED:
+            raise ValueError("fixed out of range")
+        if not _is_int(minimum_cents) or not 0 <= minimum_cents <= MAX_MINIMUM:
+            raise ValueError("bad minimum")
+        exp = _parse_date(expires)
+        key = code.upper()
+        if key in self._codes:
+            raise ValueError("duplicate code")
+        rec = DiscountCode(key, kind, value, minimum_cents, exp)
+        self._codes[key] = rec
+        return rec
+
+    def get(self, code: str) -> DiscountCode | None:
+        if not isinstance(code, str):
+            return None
+        return self._codes.get(code.upper())
diff --git a/tests/test_api_discounts.py b/tests/test_api_discounts.py
new file mode 100644
index 0000000..6343076
--- /dev/null
+++ b/tests/test_api_discounts.py
@@ -0,0 +1,251 @@
+import re
+from datetime import date
+
+from hypothesis import given, settings, strategies as st
+
+from shop.api import handle
+from shop.catalog import CATALOG
+from shop.discounts import CodeRegistry
+from shop.inventory import Inventory
+
+SKUS = list(CATALOG)
+TODAY = "2026-06-15"
+CODE_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-"
+
+
+def make_ctx(codes=None, today=TODAY, with_today=True):
+    ctx = {
+        "carts": {},
+        "inventory": Inventory({s: 10_000_000 for s in SKUS}),
+        "codes": codes if codes is not None else CodeRegistry(),
+    }
+    if with_today:
+        ctx["today"] = today
+    return ctx
+
+
+def req(method, path, body=None):
+    r = {"method": method, "path": path}
+    if body is not None:
+        r["body"] = body
+    return r
+
+
+def new_cart(ctx, lines=()):
+    r = handle(req("POST", "/carts"), ctx)
+    cid = r["body"]["cart_id"]
+    for sku, qty in lines:
+        out = handle(req("POST", f"/carts/{cid}/lines",
+                         {"sku": sku, "quantity": qty, "unit_price_cents": 1}), ctx)
+        assert out["status"] == 200
+    return cid
+
+
+def snapshot(ctx):
+    return {k: (dict(c.lines), c.code) for k, c in ctx["carts"].items()}
+
+
+lines_st = st.lists(st.tuples(st.sampled_from(SKUS), st.integers(1, 5)), max_size=3)
+iso_dates = st.dates(min_value=date(2000, 1, 1), max_value=date(2100, 1, 1))
+valid_code = st.text(alphabet=CODE_CHARS, min_size=1, max_size=20)
+
+
+@st.composite
+def registry_st(draw, min_size=0):
+    names = draw(st.lists(valid_code.map(str.upper), min_size=min_size, max_size=3,
+                          unique=True))
+    reg = CodeRegistry()
+    for n in names:
+        kind = draw(st.sampled_from(["percent", "fixed"]))
+        value = draw(st.integers(1, 50) if kind == "percent" else st.integers(1, 5000))
+        minimum = draw(st.integers(0, 10_000))
+        exp = draw(iso_dates).isoformat()
+        reg.register(n, kind, value, minimum, exp)
+    return reg, names
+
+
+# Feature: cart-discount-codes, Property 4: Apply returns the first failing check
+@settings(max_examples=200, deadline=None)
+@given(data=st.data(), lines=lines_st, today=iso_dates, pre=st.booleans())
+def test_apply_first_failing_check(data, lines, today, pre):
+    reg, names = data.draw(registry_st())
+    ctx = make_ctx(reg, today.isoformat())
+    cid = new_cart(ctx, lines)
+    cart = ctx["carts"][cid]
+    if pre and names:
+        cart.attach(reg.get(data.draw(st.sampled_from(names))))
+    kinds = [st.just(MISSING), st.text(max_size=25), st.integers(), st.none(),
+             valid_code]
+    if names:
+        kinds.append(st.sampled_from(names).map(
+            lambda n: "".join(c.lower() if i % 2 else c for i, c in enumerate(n))))
+    code = data.draw(st.one_of(*kinds))
+    body = {} if code is MISSING else {"code": code}
+    before = snapshot(ctx)
+    sub = cart.subtotal_cents()
+
+    out = handle(req("POST", f"/carts/{cid}/discount", body), ctx)
+
+    well = isinstance(code, str) and re.fullmatch(r"[A-Za-z0-9-]{1,20}", code)
+    if not well:
+        exp = (400, "bad code")
+    elif code.upper() not in names:
+        exp = (404, "unknown code")
+    elif cart.code is not None and before[cid][1] is not None:
+        exp = (409, "code already applied")
+    else:
+        rec = reg.get(code)
+        if today > rec.expires:
+            exp = (422, "code expired")
+        elif sub < rec.minimum_cents:
+            exp = (422, "minimum not met")
+        else:
+            exp = (200, None)
+    assert out["status"] == exp[0]
+    if exp[1]:
+        assert out["body"] == {"error": exp[1]}
+        assert snapshot(ctx) == before
+    else:
+        assert cart.code is reg.get(code)
+        assert out["body"]["subtotal_cents"] == sub
+        assert out["body"]["total_cents"] == sub - out["body"]["discount_cents"]
+
+
+MISSING = object()
+
+
+# Feature: cart-discount-codes, Property 5: Apply then remove restores the cart
+@settings(max_examples=200, deadline=None)
+@given(lines=lines_st, kind=st.sampled_from(["percent", "fixed"]),
+       value=st.integers(1, 50), name=valid_code)
+def test_apply_then_remove_restores(lines, kind, value, name):
+    reg = CodeRegistry()
+    reg.register(name, kind, value, 0, "2026-12-31")
+    ctx = make_ctx(reg)
+    cid = new_cart(ctx, lines)
+    sub = ctx["carts"][cid].subtotal_cents()
+    assert handle(req("POST", f"/carts/{cid}/discount", {"code": name}), ctx)["status"] == 200
+    out = handle(req("DELETE", f"/carts/{cid}/discount"), ctx)
+    assert out["status"] == 200
+    assert out["body"]["discount_cents"] == 0
+    got = handle(req("GET", f"/carts/{cid}"), ctx)["body"]
+    assert got["discount_code"] is None
+    assert got["total_cents"] == got["subtotal_cents"] == sub
+
+
+bad_today = st.one_of(
+    st.just(MISSING), st.none(), st.integers(), st.just("2026-13-01"),
+    st.just("2026-02-30"), st.dates().map(lambda d: d.strftime("%Y/%m/%d")),
+    st.text(max_size=12).filter(lambda s: not re.fullmatch(r"\d{4}-\d{2}-\d{2}", s)),
+)
+routes = st.sampled_from([
+    ("GET", "", None),
+    ("POST", "/lines", {"sku": "TEA-01", "quantity": 1, "unit_price_cents": 1}),
+    ("POST", "/discount", {"code": "SAVE"}),
+    ("DELETE", "/discount", None),
+])
+
+
+# Feature: cart-discount-codes, Property 6: Bad clock fails before anything
+@settings(max_examples=200, deadline=None)
+@given(today=bad_today, route=routes, known_cart=st.booleans(), lines=lines_st)
+def test_bad_clock_fails_first(today, route, known_cart, lines):
+    reg = CodeRegistry()
+    reg.register("SAVE", "fixed", 100, 0, "2099-01-01")
+    ctx = make_ctx(reg)
+    cid = new_cart(ctx, lines)
+    if today is MISSING:
+        del ctx["today"]
+    else:
+        ctx["today"] = today
+    before = snapshot(ctx)
+    inv = {s: ctx["inventory"].available(s) for s in SKUS}
+    method, suffix, body = route
+    path = f"/carts/{cid if known_cart else 'nope'}{suffix}"
+    try:
+        handle(req(method, path, body), ctx)
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("ValueError expected")
+    assert snapshot(ctx) == before
+    assert {s: ctx["inventory"].available(s) for s in SKUS} == inv
+
+
+junk = st.one_of(st.integers(), st.text(max_size=5), st.none(), st.booleans(),
+                 st.floats(allow_nan=True))
+
+
+def _ok_int(x, lo, hi):
+    return type(x) is int and lo <= x <= hi
+
+
+@st.composite
+def bad_line_body(draw):
+    q = draw(st.one_of(junk, st.integers(-5, 1100)))
+    p = draw(st.one_of(junk, st.integers(-5, 10_000_100)))
+    if draw(st.booleans()):
+        q = draw(st.sampled_from([1, 5, 1000]))
+    elif draw(st.booleans()):
+        p = draw(st.sampled_from([0, 450, 10_000_000]))
+    body = {"sku": "TEA-01", "quantity": q, "unit_price_cents": p}
+    for k in draw(st.sets(st.sampled_from(["quantity", "unit_price_cents"]), max_size=1)):
+        del body[k]
+    return body
+
+
+# Feature: cart-discount-codes, Property 7: Bad line body is rejected
+@settings(max_examples=200, deadline=None)
+@given(body=bad_line_body().filter(
+    lambda b: not (_ok_int(b.get("quantity"), 1, 1000)
+                   and _ok_int(b.get("unit_price_cents"), 0, 10_000_000))))
+def test_bad_line_rejected(body):
+    ctx = make_ctx()
+    cid = new_cart(ctx)
+    inv = ctx["inventory"].available("TEA-01")
+    out = handle(req("POST", f"/carts/{cid}/lines", body), ctx)
+    assert out == {"status": 400, "body": {"error": "bad line"}}
+    assert ctx["carts"][cid].lines == {}
+    assert ctx["inventory"].available("TEA-01") == inv
+
+
+# Examples
+def test_no_cart_2_7():
+    ctx = make_ctx()
+    out = handle(req("POST", "/carts/zzz/discount", {"code": "X"}), ctx)
+    assert out == {"status": 404, "body": {"error": "no cart"}}
+
+
+def test_get_fields_4_1():
+    reg = CodeRegistry()
+    reg.register("save10", "percent", 10, 0, "2026-12-31")
+    ctx = make_ctx(reg)
+    cid = new_cart(ctx, [("MUG-01", 2)])
+    handle(req("POST", f"/carts/{cid}/discount", {"code": "SAVE10"}), ctx)
+    out = handle(req("GET", f"/carts/{cid}"), ctx)
+    assert out["status"] == 200
+    assert set(out["body"]) == {"lines", "subtotal_cents", "discount_code",
+                                "discount_cents", "total_cents"}
+    assert out["body"]["lines"] == {"MUG-01": 2}
+    assert out["body"]["subtotal_cents"] == 2400
+    assert out["body"]["discount_code"] == "SAVE10"
+    assert out["body"]["discount_cents"] == 240
+    assert out["body"]["total_cents"] == 2160
+    cid2 = new_cart(ctx)
+    assert handle(req("GET", f"/carts/{cid2}"), ctx)["body"]["discount_code"] is None
+
+
+def test_lines_response_4_2():
+    ctx = make_ctx()
+    cid = new_cart(ctx)
+    out = handle(req("POST", f"/carts/{cid}/lines",
+                     {"sku": "TEA-01", "quantity": 2, "unit_price_cents": 1}), ctx)
+    assert out == {"status": 200, "body": {
+        "subtotal_cents": 900, "discount_cents": 0, "total_cents": 900}}
+
+
+def test_delete_without_code_4_4():
+    ctx = make_ctx()
+    cid = new_cart(ctx)
+    out = handle(req("DELETE", f"/carts/{cid}/discount"), ctx)
+    assert out == {"status": 404, "body": {"error": "no code applied"}}
