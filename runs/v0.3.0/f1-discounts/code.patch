new file mode 100644
index 0000000..80c9153
--- /dev/null
+++ b/tests/test_discounts.py
@@ -0,0 +1,145 @@
+import re
+from datetime import date
+
+from hypothesis import given, settings, strategies as st
+
+from shop.discounts import (
+    CODE_RE, CodeRegistry, DiscountCode, discount_cents, is_well_formed,
+)
+
+CODE_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-"
+valid_code = st.text(alphabet=CODE_CHARS, min_size=1, max_size=20)
+code_str = st.one_of(valid_code, st.text(max_size=25))
+date_str = st.one_of(
+    st.dates(min_value=date(1000, 1, 1)).map(lambda d: d.isoformat()),
+    st.sampled_from(["2026-13-01", "2026-02-30", "bad", "", "2026-1-1"]),
+    st.text(max_size=12),
+)
+int_like = st.one_of(st.integers(-10, 10_000_010), st.integers(45, 95), st.booleans())
+
+
+def _model_date_ok(s):
+    if not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", s):
+        return False
+    try:
+        date.fromisoformat(s)
+    except ValueError:
+        return False
+    return True
+
+
+def _model_ok(code, kind, value, minimum, expires, existing):
+    if not (isinstance(code, str) and re.fullmatch(r"[A-Za-z0-9-]{1,20}", code)):
+        return False
+    if kind not in ("percent", "fixed"):
+        return False
+    if type(value) is not int:
+        return False
+    if kind == "percent" and not 1 <= value <= 50:
+        return False
+    if kind == "fixed" and not 1 <= value <= 10_000_000:
+        return False
+    if type(minimum) is not int or not 0 <= minimum <= 10_000_000:
+        return False
+    if not _model_date_ok(expires):
+        return False
+    return code.upper() not in existing
+
+
+# Feature: cart-discount-codes, Property 1: Registry accepts exactly the in-bound codes
+@settings(max_examples=300)
+@given(
+    first=valid_code,
+    code=code_str,
+    kind=st.sampled_from(["percent", "fixed", "x"]),
+    value=int_like,
+    minimum=st.one_of(st.integers(-1, 10_000_001), st.booleans()),
+    expires=date_str,
+    preload=st.booleans(),
+)
+def test_registry_accepts_exactly_in_bound(first, code, kind, value, minimum, expires, preload):
+    reg = CodeRegistry()
+    existing = set()
+    if preload:
+        reg.register(first, "fixed", 1, 0, "2030-01-01")
+        existing.add(first.upper())
+    before = dict(reg._codes)
+    if _model_ok(code, kind, value, minimum, expires, existing):
+        rec = reg.register(code, kind, value, minimum, expires)
+        assert rec.code == code.upper()
+        assert reg.get(code.lower()) == rec
+        assert reg.get(code.upper()) == rec
+        assert rec.expires == date.fromisoformat(expires)
+    else:
+        try:
+            reg.register(code, kind, value, minimum, expires)
+        except ValueError:
+            pass
+        else:
+            raise AssertionError("expected ValueError")
+        assert reg._codes == before
+
+
+# Feature: cart-discount-codes, Property 2: Code_String format check
+@settings(max_examples=300)
+@given(v=st.one_of(
+    st.text(max_size=25),
+    st.from_regex(CODE_RE, fullmatch=True),
+    st.integers(),
+    st.none(),
+    st.binary(max_size=5),
+))
+def test_is_well_formed(v):
+    expected = (
+        isinstance(v, str) and 1 <= len(v) <= 20
+        and all(c in CODE_CHARS for c in v)
+    )
+    assert is_well_formed(v) is expected
+
+
+percent_code = st.builds(
+    DiscountCode, code=st.just("C"), kind=st.just("percent"),
+    value=st.integers(1, 50), minimum_cents=st.integers(0, 10_000_000),
+    expires=st.dates(),
+)
+fixed_code = st.builds(
+    DiscountCode, code=st.just("C"), kind=st.just("fixed"),
