@@ -0,0 +1,47 @@
+"""Test fakes for ctx ports. No network."""
+from shop.cart import Cart  # noqa: F401  (re-export for callers)
+from shop.giftcards import GiftCardStore
+from shop.inventory import Inventory
+from shop.ledger import Ledger, LedgerUnavailable
+from shop.payments import ChargeResult
+
+
+class FakePaymentProvider:
+    def __init__(self, result: str = "ok", refund_fails: bool = False) -> None:
+        self.result = result
+        self.refund_fails = refund_fails
+        self.charges: list[tuple[int, str, float]] = []
+        self.refunds: list[str] = []
+        self.cancels: list[str] = []
+
+    def charge(self, amount_cents: int, ref: str, timeout_s: float) -> ChargeResult:
+        self.charges.append((amount_cents, ref, timeout_s))
+        if self.result == "ok":
+            return ChargeResult("ok", f"ch_{len(self.charges)}")
+        return ChargeResult(self.result, None)
+
+    def refund(self, charge_id: str) -> None:
+        self.refunds.append(charge_id)
+        if self.refund_fails:
+            raise RuntimeError("refund failed")
+
+    def cancel(self, ref: str) -> None:
+        self.cancels.append(ref)
+
+
+class FailingLedger(Ledger):
+    def append(self, entry) -> None:  # type: ignore[override]
+        raise LedgerUnavailable("ledger down")
+
+
+def make_ctx(**over) -> dict:
+    ctx = {
+        "carts": {},
+        "inventory": Inventory({"TEA-01": 10, "MUG-01": 2}),
+        "giftcards": GiftCardStore(),
+        "ledger": Ledger(),
+        "payments": FakePaymentProvider(),
+        "staff_ids": set(),
+    }
+    ctx.update(over)
+    return ctx
