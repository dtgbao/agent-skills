@@ -0,0 +1,31 @@
+"""Void a gift card (staff only)."""
+from __future__ import annotations
+
+from datetime import datetime, timezone
+
+from shop.ledger import Entry, LedgerUnavailable
+
+
+def _err(status: int, code: str) -> dict:
+    return {"status": status, "body": {"error": code}}
+
+
+def void(code: str, body: dict, ctx: dict) -> dict:
+    actor = (body or {}).get("actor_id")
+    if not actor or actor not in ctx["staff_ids"]:
+        return _err(403, "forbidden")
+    store = ctx["giftcards"]
+    card = store.get(code)
+    if card is None:
+        return _err(404, "unknown_card")
+    with store.lock(code):
+        if card.status == "void":
+            return _err(409, "card_void")
+        try:
+            ctx["ledger"].append(
+                Entry(code, "status", card.status, "void", actor, datetime.now(timezone.utc))
+            )
+        except LedgerUnavailable:
+            return _err(503, "ledger_unavailable")
+        card.status = "void"
+    return {"status": 200, "body": {"code": code, "status": "void"}}
