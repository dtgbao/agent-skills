@@ -0,0 +1,34 @@
+"""Gift card redemption: checks, subtract, amount due."""
+from datetime import datetime, timezone
+
+from shop.giftcards import CODE_LEN
+from shop.ledger import Entry, LedgerUnavailable
+
+
+def _err(status: int, error: str) -> dict:
+    return {"status": status, "body": {"error": error}}
+
+
+def apply(body: dict, ctx: dict) -> dict:
+    body = body if isinstance(body, dict) else {}
+    code = body.get("code")
+    cart = ctx["carts"].get(str(body.get("cart_id")))
+    if not isinstance(code, str) or len(code) != CODE_LEN or cart is None or not getattr(cart, "open", False):
+        return _err(422, "invalid_request")  # 2.8, 2.9
+    store = ctx["giftcards"]
+    card = store.get(code)
+    if card is None:
+        return _err(404, "unknown_card")  # 2.4
+    with store.lock(code):  # 2.7
+        if card.status == "void":
+            return _err(409, "card_void")  # 3.2
+        s = cart.subtotal_cents()
+        b = card.balance_cents
+        new_b, due = (b - s, 0) if s <= b else (0, s - b)  # 2.1, 2.5, 2.6
+        entry = Entry(code, "balance", b, new_b, str(body.get("actor_id", "")), datetime.now(timezone.utc))
+        try:
+            ctx["ledger"].append(entry)  # 5.1
+        except LedgerUnavailable:
+            return _err(503, "ledger_unavailable")  # 5.2
+        card.balance_cents = new_b
+    return {"status": 200, "body": {"balance_cents": new_b, "amount_due_cents": due}}
