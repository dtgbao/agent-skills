@@ -0,0 +1,157 @@
+"""Property tests for gift card redemption (shop/redeem.py)."""
+import threading
+import time
+
+from hypothesis import given, settings, strategies as st
+
+from shop import redeem
+from shop.cart import Cart
+from shop.catalog import CATALOG
+from shop.giftcards import CODE_LEN, MAX_BALANCE_CENTS, GiftCard
+from shop.inventory import Inventory
+from tests.fakes import make_ctx
+
+SKUS = sorted(CATALOG)
+cart_lines = st.dictionaries(st.sampled_from(SKUS), st.integers(1, 20), max_size=3)
+
+
+def _cart(ctx, cart_id, lines, open_=True):
+    cart = Cart(Inventory({s: 10_000 for s in SKUS}))
+    cart.lines = dict(lines)
+    cart.open = open_
+    ctx["carts"][cart_id] = cart
+    return cart
+
+
+def _card(ctx, balance, status="active"):
+    store = ctx["giftcards"]
+    card = GiftCard(store.new_code(), balance, status)
+    store.add(card)
+    return card
+
+
+# Feature: gift-cards, Property 5: Redemption follows the balance model
+@settings(max_examples=200, deadline=None)
+@given(b=st.integers(0, MAX_BALANCE_CENTS), lines=cart_lines)
+def test_redemption_follows_balance_model(b, lines):
+    ctx = make_ctx()
+    card = _card(ctx, b)
+    cart = _cart(ctx, "c1", lines)
+    s = cart.subtotal_cents()
+    r = redeem.apply({"code": card.code, "cart_id": "c1", "actor_id": "u1"}, ctx)
+    assert r["status"] == 200
+    assert r["body"] == {"balance_cents": max(b - s, 0), "amount_due_cents": max(s - b, 0)}
+    assert card.balance_cents == max(b - s, 0)
+    assert 0 <= card.balance_cents <= MAX_BALANCE_CENTS
+
+
+# Feature: gift-cards, Property 6: Concurrent operations never overspend
+@settings(max_examples=100, deadline=None)
+@given(b=st.integers(0, MAX_BALANCE_CENTS), carts=st.lists(cart_lines, min_size=2, max_size=8))
+def test_concurrent_redemptions_never_overspend(b, carts):
+    ctx = make_ctx()
+    card = _card(ctx, b)
+    for i, lines in enumerate(carts):
+        _cart(ctx, f"c{i}", lines)
+    results = [None] * len(carts)
+    barrier = threading.Barrier(len(carts))
+
+    def run(i):
+        barrier.wait()
+        results[i] = redeem.apply({"code": card.code, "cart_id": f"c{i}", "actor_id": "u"}, ctx)
+
+    threads = [threading.Thread(target=run, args=(i,)) for i in range(len(carts))]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+    assert all(r["status"] == 200 for r in results)
+    subtracted = sum(
+        ctx["carts"][f"c{i}"].subtotal_cents() - r["body"]["amount_due_cents"] for i, r in enumerate(results)
+    )
+    assert card.balance_cents >= 0
+    assert subtracted == b - card.balance_cents
+    # Ledger entries form one chain: each old equals the previous new.
+    entries = ctx["ledger"].entries
+    assert len(entries) == len(carts)
+    assert entries[0].old == b
+    for prev, nxt in zip(entries, entries[1:]):
+        assert nxt.old == prev.new
+    assert entries[-1].new == card.balance_cents
+
+
+# Feature: gift-cards, Property 7: Redemption error precedence
+@settings(max_examples=200, deadline=None)
+@given(
+    bad_code=st.booleans(),
+    cart_state=st.sampled_from(["open", "closed", "missing"]),
+    unknown=st.booleans(),
+    void=st.booleans(),
+    bad_code_text=st.text(max_size=40).filter(lambda t: len(t) != CODE_LEN),
+    b=st.integers(0, MAX_BALANCE_CENTS),
+    lines=cart_lines,
+)
+def test_redemption_error_precedence(bad_code, cart_state, unknown, void, bad_code_text, b, lines):
+    ctx = make_ctx()
+    card = _card(ctx, b, "void" if void else "active")
+    other = _card(ctx, 1234)
+    if cart_state != "missing":
+        _cart(ctx, "c1", lines, open_=(cart_state == "open"))
+    if bad_code:
+        code = bad_code_text
+    elif unknown:
+        code = "!" * CODE_LEN  # 16 chars, outside the code alphabet: never issued
+    else:
+        code = card.code
+    before = {c.code: (c.balance_cents, c.status) for c in (card, other)}
+    n_entries = len(ctx["ledger"].entries)
+
+    r = redeem.apply({"code": code, "cart_id": "c1", "actor_id": "u1"}, ctx)
+
+    if bad_code or cart_state != "open":
+        expected = (422, "invalid_request")
+    elif unknown:
+        expected = (404, "unknown_card")
+    elif void:
+        expected = (409, "card_void")
+    else:
+        expected = None
+    if expected is None:
+        assert r["status"] == 200
+    else:
+        assert (r["status"], r["body"].get("error")) == expected
+        assert {c.code: (c.balance_cents, c.status) for c in (card, other)} == before
+        assert len(ctx["ledger"].entries) == n_entries
+
+
+# Example test for 2.2: 200 redemptions, 95th percentile < 2 s.
+def test_redemption_latency_p95_under_2s():
+    ctx = make_ctx()
+    durations = []
+    for i in range(200):
+        card = _card(ctx, MAX_BALANCE_CENTS)
+        _cart(ctx, f"c{i}", {"TEA-01": 2, "MUG-01": 1})
+        t0 = time.perf_counter()
+        r = redeem.apply({"code": card.code, "cart_id": f"c{i}", "actor_id": "u"}, ctx)
+        durations.append(time.perf_counter() - t0)
+        assert r["status"] == 200
+    durations.sort()
+    assert durations[int(0.95 * len(durations)) - 1] < 2.0
+
+
+# Example test for 4.1: an untouched card keeps its balance after other operations.
+def test_untouched_card_keeps_balance():
+    ctx = make_ctx(staff_ids={"staff1"})
+    keep = _card(ctx, 25_000)
+    a = _card(ctx, 10_000)
+    b = _card(ctx, 5_000)
+    for i in range(5):
+        _cart(ctx, f"c{i}", {"KET-01": 1})
+        redeem.apply({"code": a.code, "cart_id": f"c{i}", "actor_id": "u"}, ctx)
+    from shop import void as void_mod
+
+    void_mod.void(b.code, {"actor_id": "staff1"}, ctx)
+    _cart(ctx, "cx", {"TEA-01": 1})
+    redeem.apply({"code": b.code, "cart_id": "cx", "actor_id": "u"}, ctx)
+    assert keep.balance_cents == 25_000
+    assert keep.status == "active"
