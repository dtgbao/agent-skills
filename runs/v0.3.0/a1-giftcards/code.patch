@@ -0,0 +1,47 @@
+"""Gift card model and in-memory store."""
+from __future__ import annotations
+
+import secrets
+import string
+import threading
+from dataclasses import dataclass
+
+MAX_BALANCE_CENTS = 50_000
+CODE_LEN = 16
+_ALPHABET = string.ascii_uppercase + string.digits
+
+
+@dataclass
+class GiftCard:
+    code: str
+    balance_cents: int
+    status: str = "active"
+
+
+class GiftCardStore:
+    def __init__(self) -> None:
+        self._cards: dict[str, GiftCard] = {}
+        self._locks: dict[str, threading.Lock] = {}
+        self._guard = threading.Lock()
+        self.idempotent: dict[str, dict] = {}
+
+    def new_code(self) -> str:
+        with self._guard:
+            while True:
+                code = "".join(secrets.choice(_ALPHABET) for _ in range(CODE_LEN))
+                if code not in self._cards:
+                    return code
+
+    def add(self, card: GiftCard) -> GiftCard:
+        if card.balance_cents < 0 or card.balance_cents > MAX_BALANCE_CENTS:
+            raise ValueError("balance out of range")
+        with self._guard:
+            self._cards[card.code] = card
+        return card
+
+    def get(self, code: str) -> GiftCard | None:
+        return self._cards.get(code)
+
+    def lock(self, code: str) -> threading.Lock:
+        with self._guard:
+            return self._locks.setdefault(code, threading.Lock())
