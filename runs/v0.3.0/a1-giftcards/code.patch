+from hypothesis import given, settings, strategies as st
+
+from shop.giftcards import CODE_LEN
+from shop.purchase import buy
+from tests.fakes import FailingLedger, FakePaymentProvider, make_ctx
+
+S = settings(max_examples=100, deadline=None)
+valid = st.integers(10, 500)
+
+
+# Feature: gift-cards, Property 1: Valid purchase creates a matching card
+@S
+@given(v=valid)
+def test_valid_purchase_creates_matching_card(v):
+    ctx = make_ctx()
+    r = buy({"value_dollars": v, "actor_id": "u"}, ctx)
+    assert r["status"] == 201
+    code = r["body"]["code"]
+    assert len(code) == CODE_LEN
+    assert [c[0] for c in ctx["payments"].charges] == [v * 100]
+    card = ctx["giftcards"].get(code)
+    assert card.status == "active" and card.balance_cents == v * 100
+
+
+# Feature: gift-cards, Property 2: Invalid purchase value is rejected without a charge
+invalid = st.one_of(
+    st.integers(max_value=9), st.integers(min_value=501), st.floats(allow_nan=True),
+    st.text(), st.none(), st.booleans(),
+)
+
+
+@S
+@given(v=invalid)
+def test_invalid_value_rejected_no_charge(v):
+    ctx = make_ctx()
+    r = buy({"value_dollars": v, "actor_id": "u"}, ctx)
+    assert r == {"status": 422, "body": {"error": "invalid_request"}}
+    assert ctx["payments"].charges == []
+
+
+@S
+@given(st.data())
+def test_missing_value_rejected(data):
+    ctx = make_ctx()
+    r = buy({"actor_id": "u"}, ctx)
+    assert r["status"] == 422 and ctx["payments"].charges == []
+
+
+# Feature: gift-cards, Property 3: Failed charge creates no card
+@S
+@given(v=valid, res=st.sampled_from(["declined", "timeout"]))
+def test_failed_charge_creates_no_card(v, res):
+    ctx = make_ctx(payments=FakePaymentProvider(res))
+    r = buy({"value_dollars": v, "actor_id": "u"}, ctx)
+    assert r == {"status": 402, "body": {"error": "payment_failed"}}
+    assert ctx["giftcards"]._cards == {}
+    pay = ctx["payments"]
+    if res == "timeout":
+        assert pay.cancels == [pay.charges[0][1]]
+    else:
+        assert pay.cancels == []
+
+
+# Feature: gift-cards, Property 4: Purchase is idempotent per key
+@S
+@given(v=valid, n=st.integers(2, 5), key=st.text(min_size=1))
+def test_purchase_idempotent_per_key(v, n, key):
+    ctx = make_ctx()
+    body = {"value_dollars": v, "idempotency_key": key, "actor_id": "u"}
+    rs = [buy(dict(body), ctx) for _ in range(n)]
+    assert all(r == rs[0] for r in rs)
+    assert rs[0]["status"] == 201
+    assert len(ctx["payments"].charges) == 1
+    assert len(ctx["giftcards"]._cards) == 1
+
+
+# Feature: gift-cards, Property 10: Ledger failure after charge refunds or queues
+@S
+@given(v=valid, refund_fails=st.booleans())
+def test_ledger_failure_refunds_or_queues(v, refund_fails):
+    ctx = make_ctx(ledger=FailingLedger(), payments=FakePaymentProvider("ok", refund_fails))
+    r = buy({"value_dollars": v, "actor_id": "u"}, ctx)
+    pay = ctx["payments"]
+    assert r == {"status": 503, "body": {"error": "ledger_unavailable"}}
+    assert pay.refunds == ["ch_1"]
+    assert ctx["giftcards"]._cards == {}
+    q = ctx["ledger"].manual_refunds
+    if refund_fails:
+        assert len(q) == 1 and q[0]["charge_id"] == "ch_1" and q[0]["amount_cents"] == v * 100
+    else:
+        assert q == []
