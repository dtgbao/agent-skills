+"""API tests for gift-card routes. Requirements 1.2, 3.1."""
+from shop.api import handle
+from tests.fakes import make_ctx
+
+
+def _post(ctx, path, body=None):
+    return handle({"method": "POST", "path": path, "body": body or {}}, ctx)
+
+
+def _cart(ctx, sku, qty):
+    cid = _post(ctx, "/carts")["body"]["cart_id"]
+    assert _post(ctx, f"/carts/{cid}/lines", {"sku": sku, "qty": qty})["status"] == 200
+    return cid
+
+
+def test_buy_redeem_void_flow():
+    ctx = make_ctx(staff_ids={"staff1"})
+    r = _post(ctx, "/gift-cards", {"value_dollars": 10, "actor_id": "u"})
+    assert r["status"] == 201
+    code = r["body"]["code"]
+
+    c1 = _cart(ctx, "TEA-01", 2)  # 900
+    r = _post(ctx, "/gift-cards/redeem", {"code": code, "cart_id": c1})
+    assert r == {"status": 200, "body": {"balance_cents": 100, "amount_due_cents": 0}}
+
+    c2 = _cart(ctx, "MUG-01", 1)  # 1200
+    r = _post(ctx, "/gift-cards/redeem", {"code": code, "cart_id": c2})
+    assert r == {"status": 200, "body": {"balance_cents": 0, "amount_due_cents": 1100}}
+
+    r = _post(ctx, f"/gift-cards/{code}/void", {"actor_id": "staff1"})
+    assert r == {"status": 200, "body": {"code": code, "status": "void"}}
+
+    r = _post(ctx, "/gift-cards/redeem", {"code": code, "cart_id": c1})
+    assert r["status"] == 409
+
+
+def test_void_requires_staff():
+    ctx = make_ctx(staff_ids={"staff1"})
+    code = _post(ctx, "/gift-cards", {"value_dollars": 20})["body"]["code"]
+    assert _post(ctx, f"/gift-cards/{code}/void", {"actor_id": "x"})["status"] == 403
+
+
+def test_existing_cart_routes_still_work():
+    ctx = make_ctx()
+    cid = _post(ctx, "/carts")["body"]["cart_id"]
+    r = _post(ctx, f"/carts/{cid}/lines", {"sku": "TEA-01", "qty": 2})
+    assert r == {"status": 200, "body": {"subtotal_cents": 900}}
+    r = handle({"method": "GET", "path": f"/carts/{cid}"}, ctx)
+    assert r["status"] == 200 and r["body"]["subtotal_cents"] == 900
+    assert handle({"method": "GET", "path": "/carts/zz"}, ctx)["status"] == 404
+    assert _post(ctx, f"/carts/{cid}/lines", {"sku": "NOPE", "qty": 1})["status"] == 400
diff --git a/tests/test_ledger_audit.py b/tests/test_ledger_audit.py
new file mode 100644
index 0000000..3a2f56d
--- /dev/null
+++ b/tests/test_ledger_audit.py
@@ -0,0 +1,82 @@
+# Feature: gift-cards, Property 9: Every change is audited, or nothing changes
+from datetime import timezone
+
+from hypothesis import given, settings, strategies as st
+
+from shop import purchase, redeem, void
+from shop.cart import Cart
+from shop.giftcards import GiftCard
+from shop.inventory import Inventory
+from shop.ledger import Ledger
+from tests.fakes import FailingLedger, make_ctx
+
+ACTOR = "staff1"
+OPS = st.lists(st.sampled_from(["buy", "redeem", "void"]), min_size=1, max_size=12)
+
+
+def _snapshot(store):
+    return {c: (g.balance_cents, g.status) for c, g in store._cards.items()}
+
+
+def _run(op, ctx, state):
+    store = ctx["giftcards"]
+    if op == "buy":
+        r = purchase.buy({"value_dollars": 50, "actor_id": ACTOR}, ctx)
+        if r["status"] == 201:
+            state["codes"].append(r["body"]["code"])
+        return r
+    if not state["codes"]:
+        return None
+    code = state["codes"][-1]
+    if op == "redeem":
+        cart = Cart(Inventory({"TEA-01": 100}))
+        cart.add("TEA-01", 2)
+        ctx["carts"]["c1"] = cart
+        return redeem.apply({"code": code, "cart_id": "c1", "actor_id": ACTOR}, ctx)
+    return void.void(code, {"actor_id": ACTOR}, ctx)
+
+
+@settings(max_examples=100, deadline=None)
+@given(ops=OPS)
+def test_each_change_appends_one_valid_entry(ops):
+    ctx = make_ctx(staff_ids={ACTOR})
+    state = {"codes": []}
+    store, ledger = ctx["giftcards"], ctx["ledger"]
+    for op in ops:
+        before, n = _snapshot(store), len(ledger.entries)
+        r = _run(op, ctx, state)
+        after = _snapshot(store)
+        added = ledger.entries[n:]
+        if r is not None and r["status"] in (200, 201) and after != before:
+            assert len(added) == 1
+            e = added[0]
+            assert e.actor_id == ACTOR and e.at.tzinfo is not None
+            assert e.at.utcoffset() == timezone.utc.utcoffset(None)
+            if op == "buy":
+                code = r["body"]["code"]
+                assert (e.code, e.field, e.old, e.new) == (code, "balance", None, 5000)
+            elif op == "redeem":
+                assert e.field == "balance"
+                assert (e.old, e.new) == (before[e.code][0], after[e.code][0])
+            else:
+                assert (e.field, e.old, e.new) == ("status", "active", "void")
+                assert after[e.code][1] == "void"
+        else:
+            assert after == before
+            assert added == []
+
+
+@settings(max_examples=100, deadline=None)
+@given(ops=OPS, balance=st.integers(0, 50_000))
+def test_ledger_failure_returns_503_and_changes_nothing(ops, balance):
+    ctx = make_ctx(staff_ids={ACTOR}, ledger=FailingLedger())
+    store = ctx["giftcards"]
+    card = store.add(GiftCard("A" * 16, balance))
+    state = {"codes": [card.code]}
+    before = _snapshot(store)
+    for op in ops:
+        r = _run(op, ctx, state)
+        assert r["status"] == 503
+        assert r["body"] == {"error": "ledger_unavailable"}
+        assert _snapshot(store) == before
+        assert ctx["ledger"].entries == []
