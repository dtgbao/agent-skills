+"""Property 8: Only staff can void. Validates: Requirements 3.1, 3.3, 3.4."""
+from hypothesis import given, strategies as st
+
+from shop.giftcards import GiftCard
+from shop.void import void
+from tests.fakes import make_ctx
+
+ids = st.text(min_size=0, max_size=8)
+
+
+def _setup(staff):
+    ctx = make_ctx(staff_ids=set(staff))
+    ctx["giftcards"].add(GiftCard("CODE", 5000))
+    return ctx
+
+
+@given(staff=st.sets(ids, max_size=5), actor=st.one_of(st.none(), ids))
+def test_only_staff_can_void(staff, actor):
+    ctx = _setup(staff)
+    card = ctx["giftcards"].get("CODE")
+    r = void("CODE", {"actor_id": actor}, ctx)
+    if actor and actor in staff:
+        assert r["status"] == 200
+        assert r["body"] == {"code": "CODE", "status": "void"}
+        assert card.status == "void"
+        assert len(ctx["ledger"].entries) == 1
+    else:
+        assert r == {"status": 403, "body": {"error": "forbidden"}}
+        assert card.status == "active"
+        assert card.balance_cents == 5000
+        assert ctx["ledger"].entries == []
+
+
+@given(staff=st.sets(ids, max_size=5))
+def test_missing_body_forbidden(staff):
+    ctx = _setup(staff)
+    assert void("CODE", {}, ctx)["status"] == 403
+    assert void("CODE", None, ctx)["status"] == 403
+    assert ctx["giftcards"].get("CODE").status == "active"
