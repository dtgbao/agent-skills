@@ -0,0 +1,58 @@
+"""Gift card purchase: charge, ledger, create, idempotency."""
+from __future__ import annotations
+
+import uuid
+from datetime import datetime, timezone
+
+from shop.giftcards import GiftCard
+from shop.ledger import Entry, LedgerUnavailable
+
+CHARGE_TIMEOUT_S = 10
+MIN_DOLLARS, MAX_DOLLARS = 10, 500
+
+
+def _err(status: int, error: str) -> dict:
+    return {"status": status, "body": {"error": error}}
+
+
+def _valid_value(v) -> bool:
+    return type(v) is int and MIN_DOLLARS <= v <= MAX_DOLLARS
+
+
+def buy(body: dict, ctx: dict) -> dict:
+    store, ledger, payments = ctx["giftcards"], ctx["ledger"], ctx["payments"]
+    body = body or {}
+    key = body.get("idempotency_key")
+    if key and key in store.idempotent:  # 1.9, 1.10
+        return store.idempotent[key]
+
+    value = body.get("value_dollars")
+    if not _valid_value(value):  # 1.7, 1.8
+        return _err(422, "invalid_request")
+    cents = value * 100
+
+    ref = f"gc_{uuid.uuid4().hex}"
+    result = payments.charge(cents, ref, CHARGE_TIMEOUT_S)  # 1.1
+    if result.status == "timeout":
+        payments.cancel(ref)  # 1.6
+    if result.status != "ok":
+        return _err(402, "payment_failed")  # 1.3, 1.4
+
+    code = store.new_code()
+    now = datetime.now(timezone.utc)
+    try:
+        ledger.append(Entry(code, "balance", None, cents, body.get("actor_id", ""), now))  # 5.1
+    except LedgerUnavailable:
+        try:
+            payments.refund(result.charge_id)  # 5.3
+        except Exception:
+            ledger.manual_refunds.append(  # 5.4
+                {"charge_id": result.charge_id, "amount_cents": cents, "at": datetime.now(timezone.utc)}
+            )
+        return _err(503, "ledger_unavailable")  # 5.2
+
+    store.add(GiftCard(code, cents))  # 1.5
+    response = {"status": 201, "body": {"code": code}}  # 1.2
+    if key:
+        store.idempotent[key] = response
+    return response
