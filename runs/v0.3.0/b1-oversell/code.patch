@@ -0,0 +1,67 @@
+import pytest
+from hypothesis import given, settings, strategies as st
+from shop.cart import Cart
+from shop.inventory import Inventory, OutOfStock
+
+
+def test_single_reserve_over_stock_raises():  # 3.1
+    inv = Inventory({"MUG-01": 2})
+    with pytest.raises(OutOfStock):
+        inv.reserve("MUG-01", 3)
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_qty_below_one_raises(qty):  # 3.2
+    inv = Inventory({"MUG-01": 5})
+    with pytest.raises(ValueError):
+        inv.reserve("MUG-01", qty)
+
+
+def test_release_over_reserved_stays_le_initial():  # 3.3
+    inv = Inventory({"MUG-01": 5})
+    inv.reserve("MUG-01", 2)
+    inv.release("MUG-01", 10)
+    assert inv.available("MUG-01") <= 5
+
+
+def test_cart_remove_restores_available():  # 3.4
+    inv = Inventory({"MUG-01": 5})
+    c = Cart(inv)
+    c.add("MUG-01", 3)
+    c.remove("MUG-01")
+    assert inv.available("MUG-01") == 5
+
+
+def test_fit_exact_add_gives_zero():  # 3.5
+    inv = Inventory({"MUG-01": 5})
+    a, b = Cart(inv), Cart(inv)
+    a.add("MUG-01", 3)
+    b.add("MUG-01", 2)
+    assert inv.available("MUG-01") == 0
+
+
+def test_unknown_sku_raises_keyerror():  # 3.6
+    c = Cart(Inventory({"MUG-01": 5}))
+    with pytest.raises(KeyError):
+        c.add("NOPE-99", 1)
+
+
+# Feature: cart-oversell, Property 2: Preservation
+@settings(max_examples=100)
+@given(
+    stock=st.integers(1, 50),
+    ops=st.lists(
+        st.tuples(st.booleans(), st.integers(1, 60)), max_size=30
+    ),
+)
+def test_property_preservation(stock, ops):
+    inv = Inventory({"MUG-01": stock})
+    for is_reserve, qty in ops:
+        if is_reserve:
+            avail = inv.available("MUG-01")
+            if qty <= avail:
+                inv.reserve("MUG-01", qty)
+                assert inv.available("MUG-01") == avail - qty
+        else:
+            inv.release("MUG-01", qty)
+            assert inv.available("MUG-01") <= stock
