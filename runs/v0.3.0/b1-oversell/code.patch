@@ -0,0 +1,27 @@
+import pytest
+from hypothesis import given, settings, strategies as st
+
+from shop.inventory import Inventory, OutOfStock
+
+
+# Feature: cart-oversell, Property 1: Fix check
+@settings(max_examples=200)
+@given(
+    stock=st.integers(0, 50),
+    qtys=st.lists(st.integers(1, 20), min_size=1, max_size=20),
+)
+def test_reserve_never_oversells(stock, qtys):
+    inv = Inventory({"MUG-01": stock})
+    model = stock
+    for qty in qtys:
+        before = inv.available("MUG-01")
+        assert before == model
+        if qty > model:
+            with pytest.raises(OutOfStock):
+                inv.reserve("MUG-01", qty)
+            assert inv.available("MUG-01") == before
+        else:
+            inv.reserve("MUG-01", qty)
+            model -= qty
+            assert inv.available("MUG-01") == model
+        assert inv.available("MUG-01") >= 0
