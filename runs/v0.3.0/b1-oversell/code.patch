@@ -0,0 +1,44 @@
+import pytest
+from shop import api
+from shop.cart import Cart
+from shop.inventory import Inventory, OutOfStock
+
+
+def test_second_cart_over_stock_raises():
+    inv = Inventory({"MUG-01": 5})
+    a, b = Cart(inv), Cart(inv)
+    a.add("MUG-01", 3)
+    with pytest.raises(OutOfStock):
+        b.add("MUG-01", 3)
+
+
+def test_available_stays_after_rejected_reserve():
+    inv = Inventory({"MUG-01": 5})
+    a, b = Cart(inv), Cart(inv)
+    a.add("MUG-01", 3)
+    with pytest.raises(OutOfStock):
+        b.add("MUG-01", 3)
+    assert inv.available("MUG-01") == 2
+
+
+def test_rejected_add_leaves_no_line():
+    inv = Inventory({"MUG-01": 5})
+    a, b = Cart(inv), Cart(inv)
+    a.add("MUG-01", 3)
+    with pytest.raises(OutOfStock):
+        b.add("MUG-01", 3)
+    assert "MUG-01" not in b.lines
+
+
+def test_api_second_cart_returns_409():
+    ctx = {"carts": {}, "inventory": Inventory({"MUG-01": 5})}
+    api.handle({"method": "POST", "path": "/carts"}, ctx)
+    api.handle({"method": "POST", "path": "/carts"}, ctx)
+    first = api.handle(
+        {"method": "POST", "path": "/carts/1/lines", "body": {"sku": "MUG-01", "qty": 3}}, ctx
+    )
+    assert first["status"] == 200
+    res = api.handle(
+        {"method": "POST", "path": "/carts/2/lines", "body": {"sku": "MUG-01", "qty": 3}}, ctx
+    )
+    assert res["status"] == 409
