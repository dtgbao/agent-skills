+++ b/shop/ledger.py
@@ -0,0 +1,30 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class LedgerEntry:
+    code: str
+    field: str  # "balance" | "status"
+    old: int | str | None  # None at creation
+    new: int | str
+    actor_id: str
+    ts: str  # UTC ISO 8601, ends with "+00:00"
+
+
+class LedgerUnavailable(Exception):
+    pass
+
+
+class Ledger:
+    """Append-only record of balance and status changes. fail=True makes every append raise."""
+
+    def __init__(self, fail: bool = False) -> None:
+        self._fail = fail
+        self.entries: list[LedgerEntry] = []
+
+    def append(self, entry: LedgerEntry) -> None:
+        if self._fail:
+            raise LedgerUnavailable("ledger unavailable")
+        self.entries.append(entry)
