index 0000000..e69311b
--- /dev/null
+++ b/shop/giftcards.py
@@ -0,0 +1,99 @@
+from __future__ import annotations
+
+import secrets
+import string
+import threading
+from dataclasses import dataclass, replace
+from datetime import datetime, timezone
+from typing import Callable
+
+from shop.ledger import Ledger, LedgerEntry
+
+CODE_ALPHABET = string.ascii_uppercase + string.digits
+CODE_LENGTH = 16
+
+
+def utc_now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+@dataclass
+class GiftCard:
+    code: str
+    balance_cents: int
+    status: str  # "active" | "void"
+
+
+class UnknownCard(Exception):
+    pass
+
+
+class CardVoid(Exception):
+    pass
+
+
+class InsufficientBalance(Exception):
+    pass
+
+
+class GiftCardStore:
+    """In-memory gift cards. All mutations hold one lock; ledger append runs before commit."""
+
+    def __init__(self, ledger: Ledger, now: Callable[[], datetime] = utc_now) -> None:
+        self._ledger = ledger
+        self._now = now
+        self._lock = threading.Lock()
+        self._cards: dict[str, GiftCard] = {}
+
+    def _ts(self) -> str:
+        return self._now().astimezone(timezone.utc).isoformat()
+
+    def _new_code(self) -> str:
+        while True:
+            code = "".join(secrets.choice(CODE_ALPHABET) for _ in range(CODE_LENGTH))
+            if code not in self._cards:
+                return code
+
+    def get(self, code: str) -> GiftCard | None:
+        with self._lock:
+            card = self._cards.get(code)
+            return replace(card) if card is not None else None
+
+    def create(self, balance_cents: int, actor_id: str) -> GiftCard:
+        with self._lock:
+            code = self._new_code()
+            self._ledger.append(
+                LedgerEntry(code, "balance", None, balance_cents, actor_id, self._ts())
+            )
+            card = GiftCard(code, balance_cents, "active")
+            self._cards[code] = card
+            return replace(card)
+
+    def redeem(self, code: str, amount_cents: int, actor_id: str) -> GiftCard:
+        with self._lock:
+            card = self._cards.get(code)
+            if card is None:
+                raise UnknownCard(code)
+            if card.status == "void":
+                raise CardVoid(code)
+            if amount_cents > card.balance_cents:
+                raise InsufficientBalance(code)
+            new = card.balance_cents - amount_cents
+            self._ledger.append(
+                LedgerEntry(code, "balance", card.balance_cents, new, actor_id, self._ts())
+            )
+            card.balance_cents = new
+            return replace(card)
+
+    def void(self, code: str, actor_id: str) -> GiftCard:
+        with self._lock:
+            card = self._cards.get(code)
+            if card is None:
+                raise UnknownCard(code)
+            if card.status == "void":
+                return replace(card)  # no change, no ledger entry
+            self._ledger.append(
+                LedgerEntry(code, "status", card.status, "void", actor_id, self._ts())
+            )
+            card.status = "void"
+            return replace(card)
