index 0000000..ffd3466
--- /dev/null
+++ b/shop/discounts.py
@@ -0,0 +1,63 @@
+import re
+from dataclasses import dataclass
+from datetime import date
+from typing import Literal
+
+CODE_RE = re.compile(r"[A-Z0-9-]{1,20}")
+PERCENT_MIN, PERCENT_MAX = 1, 50
+
+
+def _is_int(x: object) -> bool:
+    return isinstance(x, int) and not isinstance(x, bool)
+
+
+@dataclass(frozen=True)
+class DiscountCode:
+    code: str
+    kind: Literal["percent", "fixed"]
+    value: int
+    expires_on: date
+    min_subtotal_cents: int = 0
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.code, str) or not CODE_RE.fullmatch(self.code):
+            raise ValueError(f"bad code format: {self.code!r}")
+        if self.kind not in ("percent", "fixed"):
+            raise ValueError(f"bad kind: {self.kind!r}")
+        if not _is_int(self.value):
+            raise ValueError(f"value must be an integer: {self.value!r}")
+        if self.kind == "percent" and not PERCENT_MIN <= self.value <= PERCENT_MAX:
+            raise ValueError(f"percent value out of range: {self.value}")
+        if self.kind == "fixed" and self.value < 1:
+            raise ValueError(f"fixed value must be >= 1: {self.value}")
+        if not _is_int(self.min_subtotal_cents) or self.min_subtotal_cents < 0:
+            raise ValueError(f"bad min_subtotal_cents: {self.min_subtotal_cents!r}")
+
+
+class CodeRegistry:
+    def __init__(self) -> None:
+        self._codes: dict[str, DiscountCode] = {}
+
+    def add(self, dc: DiscountCode) -> None:
+        if dc.code in self._codes:
+            raise ValueError(f"duplicate code: {dc.code}")
+        self._codes[dc.code] = dc
+
+    def get(self, code: str) -> DiscountCode | None:
+        return self._codes.get(code)
+
+
+def is_expired(dc: DiscountCode, today: date) -> bool:
+    return today > dc.expires_on
+
+
+def discount_amount(dc: DiscountCode | None, subtotal_cents: int, today: date) -> int:
+    if dc is None:
+        return 0
+    if subtotal_cents < dc.min_subtotal_cents:
+        return 0
+    if is_expired(dc, today):
+        return 0
+    if dc.kind == "percent":
+        return subtotal_cents * dc.value // 100
+    return min(dc.value, subtotal_cents)
diff --git a/tests/test_api_codes.py b/tests/test_api_codes.py
new file mode 100644
index 0000000..08dba6c
--- /dev/null
+++ b/tests/test_api_codes.py
@@ -0,0 +1,124 @@
+# Feature: discount-codes, Property 6: POST code status follows the check order
+from datetime import date, timedelta
+
+from hypothesis import given, settings, strategies as st
+
+from shop.api import handle
+from shop.catalog import CATALOG
+from shop.discounts import CodeRegistry, DiscountCode
+from shop.inventory import Inventory
+
+SKU = next(iter(CATALOG))
+TODAY = date(2026, 6, 1)
+
+
+def make_ctx(codes=()):
+    reg = CodeRegistry()
+    for c in codes:
+        reg.add(c)
+    return {"carts": {}, "inventory": Inventory({s: 1000 for s in CATALOG}), "codes": reg, "today": TODAY}
+
+
+def req(ctx, method, path, body=None):
+    r = {"method": method, "path": path}
+    if body is not None:
+        r["body"] = body
+    return handle(r, ctx)
+
+
+def new_cart(ctx, qty=1):
+    cid = req(ctx, "POST", "/carts")["body"]["cart_id"]
+    if qty:
+        assert req(ctx, "POST", f"/carts/{cid}/lines", {"sku": SKU, "qty": qty})["status"] == 200
+    return cid
+
+
+def mk(code="SAVE", kind="percent", value=10, expires_on=TODAY, minimum=0):
+    return DiscountCode(code=code, kind=kind, value=value, expires_on=expires_on, min_subtotal_cents=minimum)
+
+
+@settings(max_examples=200, deadline=None)
+@given(
+    cart_known=st.booleans(),
+    body_kind=st.sampled_from(["valid", "missing", "nonstr"]),
+    code_known=st.booleans(),
+    expired=st.booleans(),
+    min_met=st.booleans(),
+    held=st.booleans(),
+)
+def test_property6_check_order(cart_known, body_kind, code_known, expired, min_met, held):
+    other = mk("OTHER")
+    ctx = make_ctx([other])
+    cid = new_cart(ctx)
+    sub = req(ctx, "GET", f"/carts/{cid}")["body"]["subtotal_cents"]
+    target = mk(
+        "TARGET",
+        expires_on=TODAY - timedelta(days=1) if expired else TODAY,
+        minimum=0 if min_met else sub + 1,
+    )
+    if code_known:
+        ctx["codes"].add(target)
+    if held:
+        ctx["carts"][cid].apply_code(other)
+    body = {"valid": {"code": "TARGET"}, "missing": {}, "nonstr": {"code": 5}}[body_kind]
+    path = f"/carts/{cid if cart_known else 'nope'}/code"
+    res = req(ctx, "POST", path, body)
+
+    if not cart_known:
+        exp = (404, "no cart")
+    elif body_kind != "valid":
+        exp = (400, "bad code")
+    elif not code_known:
+        exp = (404, "unknown code")
+    elif expired:
+        exp = (410, "code expired")
+    elif not min_met:
+        exp = (422, "minimum not met")
+    elif held:
+        exp = (409, "code already applied")
+    else:
+        exp = (200, None)
+    assert res["status"] == exp[0]
+    if exp[1]:
+        assert res["body"]["error"] == exp[1]
+    if cart_known:
+        applied = ctx["carts"][cid].applied_code
+        if exp[0] == 200:
+            assert applied is target
+        elif held:
+            assert applied is other
+        else:
+            assert applied is None
+
+
+def test_apply_then_get_shows_code_and_discount():
+    ctx = make_ctx([mk("SAVE", value=10)])
+    cid = new_cart(ctx)
+    sub = req(ctx, "GET", f"/carts/{cid}")["body"]["subtotal_cents"]
+    assert req(ctx, "POST", f"/carts/{cid}/code", {"code": "SAVE"})["status"] == 200
+    b = req(ctx, "GET", f"/carts/{cid}")["body"]
+    assert b["code"] == "SAVE"
+    assert b["discount_cents"] == sub * 10 // 100
+    assert b["total_cents"] == sub - b["discount_cents"]
+
+
+def test_delete_clears_code():
+    ctx = make_ctx([mk("SAVE")])
+    cid = new_cart(ctx)
+    req(ctx, "POST", f"/carts/{cid}/code", {"code": "SAVE"})
+    assert req(ctx, "DELETE", f"/carts/{cid}/code")["status"] == 200
+    b = req(ctx, "GET", f"/carts/{cid}")["body"]
+    assert b["code"] is None and b["discount_cents"] == 0
+
+
+def test_delete_without_code_returns_200():
+    ctx = make_ctx()
+    cid = new_cart(ctx)
+    before = req(ctx, "GET", f"/carts/{cid}")["body"]
+    assert req(ctx, "DELETE", f"/carts/{cid}/code")["status"] == 200
+    assert req(ctx, "GET", f"/carts/{cid}")["body"] == before
+
+
+def test_delete_unknown_cart_404():
+    res = req(make_ctx(), "DELETE", "/carts/nope/code")
+    assert res["status"] == 404 and res["body"]["error"] == "no cart"
