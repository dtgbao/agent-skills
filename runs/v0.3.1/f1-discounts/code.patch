+++ b/tests/test_cart_discount.py
@@ -0,0 +1,84 @@
+from datetime import date, timedelta
+
+import pytest
+from hypothesis import given, settings, strategies as st
+
+from shop.cart import AlreadyApplied, Cart
+from shop.catalog import CATALOG
+from shop.discounts import PERCENT_MAX, PERCENT_MIN, DiscountCode
+from shop.inventory import Inventory
+
+SKUS = list(CATALOG)
+D0 = date(2026, 1, 1)
+
+codes = st.one_of(
+    st.builds(
+        DiscountCode,
+        code=st.just("CODE"),
+        kind=st.just("percent"),
+        value=st.integers(PERCENT_MIN, PERCENT_MAX),
+        expires_on=st.dates(date(2025, 1, 1), date(2027, 1, 1)),
+        min_subtotal_cents=st.integers(0, 5000),
+    ),
+    st.builds(
+        DiscountCode,
+        code=st.just("CODE"),
+        kind=st.just("fixed"),
+        value=st.integers(1, 100000),
+        expires_on=st.dates(date(2025, 1, 1), date(2027, 1, 1)),
+        min_subtotal_cents=st.integers(0, 5000),
+    ),
+)
+
+
+def make_cart(lines):
+    cart = Cart(Inventory({s: 1000 for s in SKUS}))
+    for sku, qty in lines.items():
+        cart.add(sku, qty)
+    return cart
+
+
+# Feature: discount-codes, Property 3: Total stays between 0 and subtotal
+@settings(max_examples=200)
+@given(
+    lines=st.dictionaries(st.sampled_from(SKUS), st.integers(1, 20)),
+    dc=st.one_of(st.none(), codes),
+    today=st.dates(date(2025, 1, 1), date(2027, 1, 1)),
+)
+def test_total_between_zero_and_subtotal(lines, dc, today):
+    cart = make_cart(lines)
+    if dc is not None:
+        cart.apply_code(dc)
+    sub = cart.subtotal_cents()
+    disc = cart.discount_cents(today)
+    assert cart.total_cents(today) == sub - disc
+    assert 0 <= cart.total_cents(today) <= sub
+    if dc is None:
+        assert disc == 0
+
+
+def test_second_apply_raises_and_keeps_first():
+    cart = make_cart({"TEA-01": 1})
+    a = DiscountCode("AAA", "percent", 10, D0 + timedelta(days=10))
+    b = DiscountCode("BBB", "fixed", 100, D0 + timedelta(days=10))
+    cart.apply_code(a)
+    with pytest.raises(AlreadyApplied):
+        cart.apply_code(b)
+    assert cart.applied_code == a
+
+
+def test_clear_code_on_empty_cart_is_noop():
+    cart = Cart(Inventory({}))
+    cart.clear_code()
+    assert cart.applied_code is None
+    assert cart.discount_cents(D0) == 0
+    assert cart.total_cents(D0) == 0
+
+
+def test_today_is_argument():
+    cart = make_cart({"MUG-01": 1})
+    cart.apply_code(DiscountCode("EXP", "fixed", 100, D0))
+    assert cart.discount_cents(D0) == 100
+    assert cart.total_cents(D0) == cart.subtotal_cents() - 100
+    assert cart.discount_cents(D0 + timedelta(days=1)) == 0
+    assert cart.total_cents(D0 + timedelta(days=1)) == cart.subtotal_cents()
