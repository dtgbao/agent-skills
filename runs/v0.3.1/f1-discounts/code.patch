@@ -0,0 +1,80 @@
+import re
+from datetime import date, timedelta
+
+import pytest
+from hypothesis import given, settings, strategies as st
+
+from shop.discounts import CodeRegistry, DiscountCode, discount_amount
+
+N = 200
+CODE_ST = st.text(alphabet="ABCXYZ019-", min_size=1, max_size=20)
+DATE_ST = st.dates(min_value=date(2000, 1, 1), max_value=date(2100, 1, 1))
+CENTS = st.integers(min_value=0, max_value=10**9)
+
+
+@st.composite
+def valid_code(draw, kind=None):
+    k = kind or draw(st.sampled_from(["percent", "fixed"]))
+    v = draw(st.integers(1, 50) if k == "percent" else st.integers(1, 10**7))
+    return DiscountCode(draw(CODE_ST), k, v, draw(DATE_ST), draw(st.integers(0, 10**6)))
+
+
+# Feature: discount-codes, Property 1: Percent discount is floor of percent of subtotal
+@settings(max_examples=N)
+@given(valid_code("percent"), CENTS, st.integers(0, 365))
+def test_percent_floor(dc, extra, back):
+    sub = dc.min_subtotal_cents + extra
+    today = dc.expires_on - timedelta(days=back)
+    assert discount_amount(dc, sub, today) == sub * dc.value // 100
+
+
+# Feature: discount-codes, Property 2: Fixed discount is capped at subtotal
+@settings(max_examples=N)
+@given(valid_code("fixed"), CENTS, st.integers(0, 365))
+def test_fixed_capped(dc, extra, back):
+    sub = dc.min_subtotal_cents + extra
+    today = dc.expires_on - timedelta(days=back)
+    assert discount_amount(dc, sub, today) == min(dc.value, sub)
+
+
+# Feature: discount-codes, Property 4: Invalid applied code gives zero discount
+@settings(max_examples=N)
+@given(valid_code(), CENTS, st.integers(1, 365))
+def test_below_min_or_expired_is_zero(dc, sub, days):
+    assert discount_amount(dc, dc.min_subtotal_cents - 1, dc.expires_on) == 0
+    assert discount_amount(dc, sub + dc.min_subtotal_cents, dc.expires_on + timedelta(days=days)) == 0
+
+
+# Feature: discount-codes, Property 5: Code record validation
+@settings(max_examples=N)
+@given(
+    st.text(alphabet="ABZ09-az _", max_size=24),
+    st.sampled_from(["percent", "fixed"]),
+    st.integers(-5, 120),
+    st.integers(-5, 1000),
+)
+def test_record_validation(code, kind, value, minsub):
+    ok = (
+        re.fullmatch(r"[A-Z0-9-]{1,20}", code) is not None
+        and (1 <= value <= 50 if kind == "percent" else value >= 1)
+        and minsub >= 0
+    )
+    d = date(2030, 1, 1)
+    if ok:
+        dc = DiscountCode(code, kind, value, d, minsub)
+        reg = CodeRegistry()
+        reg.add(dc)
+        assert reg.get(code) == dc
+    else:
+        with pytest.raises(ValueError):
+            DiscountCode(code, kind, value, d, minsub)
+
+
+def test_duplicate_add_keeps_first():
+    reg = CodeRegistry()
+    a = DiscountCode("A1", "percent", 10, date(2030, 1, 1))
+    b = DiscountCode("A1", "fixed", 500, date(2031, 1, 1))
+    reg.add(a)
+    with pytest.raises(ValueError):
+        reg.add(b)
+    assert reg.get("A1") is a
